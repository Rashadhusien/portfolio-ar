# Copy to .env (or .env.local) and fill in real values. Never commit the filled file.

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Initial admin account used by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EmailJS (public by design — restrict allowed origins in the EmailJS dashboard)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public site URL (used for metadata/canonical URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
